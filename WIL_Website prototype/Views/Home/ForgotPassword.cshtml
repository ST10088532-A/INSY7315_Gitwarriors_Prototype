@model WIL_Website_prototype.Models.ForgotPassword
@{
    ViewData["Title"] = "Forgot Password";
}

<h1>Forgot Password</h1>
<p>Enter your email address and we will send password reset instructions.</p>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<form asp-controller="Home" asp-action="ForgotPassword" method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Send reset link</button>
</form>

<p class="mt-3">
    <a asp-controller="Home" asp-action="Login">Back to login</a>
</p>
