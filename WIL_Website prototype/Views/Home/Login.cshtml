@model WIL_Website_prototype.Models.Login
@{
    ViewData["Title"] = "Portal Login";
}
<div class="auth-card">
<h1>Portal Login</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<form asp-controller="Home" asp-action="Login" method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <input asp-for="Password" type="password" class="form-control" />
    </div>
    <div class="mb-3">
        <a asp-controller="Home" asp-action="ForgotPassword">Forgot password?</a>
    </div>
    <button type="submit" class="btn btn-primary">Login</button>
</form>

<p class="mt-3">
    Don't have an account?
    <a asp-controller="Home" asp-action="Register">Register</a>
</p>
