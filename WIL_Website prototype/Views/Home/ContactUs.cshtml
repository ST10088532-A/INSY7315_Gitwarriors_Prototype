@{
    ViewData["Title"] = "Contact Us";
}

<div class="text-center mb-4">
    <h2 class="display-4">Contact Us</h2>
    <p class="lead">We'd love to hear from you. Reach out using the form or details below.</p>
</div>

<div class="row g-4">
    <!-- Left: Contact Form -->
    <div class="col-md-7">
        <div class="auth-card">
            <h4 class="mb-3">Send us a message</h4>
            <form asp-controller="Home" asp-action="Contact" method="post">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input name="Name" class="form-control" placeholder="Your full name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="Email" type="email" class="form-control" placeholder="you@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone</label>
                    <input name="Phone" class="form-control" placeholder="Optional" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea name="Message" class="form-control" rows="5" placeholder="How can we help?"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
    </div>

    <!-- Right: Contact Details -->
    <div class="col-md-5">
        <div class="auth-card h-95">
            <h4 class="mb-3">Get in touch</h4>

            <div class="mb-4">
                <h6 class="fw-bold">Phone</h6>
                <p class="mb-0"><a href="tel:0113460001">+27 11 346 0001</a></p>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold">Email</h6>
                <p class="mb-0"><a href="mailto:info@itanywhere.co.za">info@itanywhere.co.za</a></p>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold">Support Hours</h6>
                <p class="mb-0">Mon &ndash; Fri: 08:00 &ndash; 17:00</p>
                <p class="mb-0">Critical Support: 24/7/365</p>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold">Johannesburg Office</h6>
                <p class="mb-0">119, 11th Street, Parkmore, Sandton, 2196</p>
            </div>

            <div class="mb-0">
                <h6 class="fw-bold">Umhlanga Office</h6>
                <p class="mb-0">1st Floor Kamdar House, 68 Richefond Circle, Umhlanga Ridge, 4319</p>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="auth-card p-0" style="max-width: 100%;">
                <iframe src="https://maps.google.com/maps?q=Johannesburg,South+Africa&z=11&output=embed"
                        width="100%"
                        height="400"
                        style="border:0; border-radius: 10px;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</div>